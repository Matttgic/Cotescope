# App
NEXT_PUBLIC_APP_NAME="CoteScope FR"
# Default method: cotescope | cotes-value (baseline) | demo | live
# Both real methods read published prices; no paid call is triggered.
DEFAULT_DATA_SOURCE="cotescope"

# The Odds API - server-side only. Never prefix this key with NEXT_PUBLIC_.
THE_ODDS_API_KEY=""
THE_ODDS_API_BASE_URL="https://api.the-odds-api.com"

# Neon Postgres - server-side only. Never expose this in NEXT_PUBLIC_*.
DATABASE_URL=""

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Same private value in Vercel and GitHub Actions for automatic paper trading.
# Never paste it into chat. No PulseScore request is made by the paper cron.
CRON_SECRET=""

# PulseScore Pro - same name as cotes-value, server/CLI only.
# Key entry alone does not start a paid collector.
PULSESCORE_KEY=""
